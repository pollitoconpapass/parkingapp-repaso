    "description": "Coleccion de pruebas de ParkingApp API (repaso). Ejecute los requests en el orden en que aparecen. Para volver a empezar, detenga y vuelva a ejecutar la aplicacion (los datos iniciales se recargan al iniciar). Cada request indica su resultado esperado y trae pruebas automaticas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "stays",
      "description": "Registrar estadia.",
      "item": [
        {
          "name": "Registrar estadia - caso 1 (auto)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Codigo de respuesta 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Cobro 25.00\", function () { var j = pm.response.json(); pm.expect(j.id).to.eql(2); pm.expect(j.plate).to.eql(\"ABC-123\"); pm.expect(j.lotName).to.eql(\"Playa Centro\"); pm.expect(j.hours).to.eql(5); pm.expect(j.charge).to.eql(25.00); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/stays",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "stays"
              ]
            },
            "description": "Resultado esperado: 201 Created | id 2 | ABC-123 | Playa Centro | hours 5 | charge 25.00.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": 1,\n  \"lotId\": 1,\n  \"hours\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
