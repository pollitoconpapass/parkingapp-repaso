    {
      "name": "reports",
      "description": "Reporte de un vehiculo.",
      "item": [
        {
          "name": "Reporte de un vehiculo - caso exitoso",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Codigo de respuesta 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Reporte esperado\", function () { var j = pm.response.json(); pm.expect(j.plate).to.eql(\"ABC-123\"); pm.expect(j.totalStays).to.eql(2); pm.expect(j.totalHours).to.eql(8); pm.expect(j.totalCharged).to.eql(40.00); pm.expect(j.averageCharge).to.eql(20.00); pm.expect(j.highestCharge).to.eql(25.00); pm.expect(j.stays.length).to.eql(2); pm.expect(j.stays[0].lotName).to.eql(\"Playa Centro\"); pm.expect(j.stays[0].hours).to.eql(5); pm.expect(j.stays[0].charge).to.eql(25.00); pm.expect(j.stays[1].lotName).to.eql(\"Playa Centro\"); pm.expect(j.stays[1].hours).to.eql(3); pm.expect(j.stays[1].charge).to.eql(15.00); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/reports/vehicles/1/summary",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "reports",
                "vehicles",
                "1",
                "summary"
              ]
            },
            "description": "Resultado esperado: 200 OK | ABC-123 | totalStays 2 | totalHours 8 | totalCharged 40.00 | averageCharge 20.00 | highestCharge 25.00."
          }
        }
      ]
    }
